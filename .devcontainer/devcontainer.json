// Advanced classroom environment for web development (AI assistance, ESLint,
// Vitest, Playwright). Extends ghcr.io/majikmate/devcontainer-base:2 (see
// .devcontainer/Dockerfile). Formatting (Prettier, standard style, Tailwind CSS
// class sorting) comes from the base image.
// Documentation: https://github.com/majikmate/devcontainer-classroom-web-advanced#readme
{
  "name": "Classroom Advanced Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Classroom-specific VS Code configuration (added to the base configuration)
  "customizations": {
    "vscode": {
      "extensions": [
        // AI: GitHub Copilot (chat, inline suggestions) is built into VS Code
        // and enabled in this image; students sign in with their GitHub account.
        // Code quality
        "dbaeumer.vscode-eslint",
        // Issues and pull requests (used by the githubIssues/githubPullRequests settings)
        "github.vscode-pull-request-github",
        // Educational extensions
        "ms-vscode.live-server",
        "tyriar.lorem-ipsum",
        "bradlc.vscode-tailwindcss",
        "dsznajder.es7-react-js-snippets",
        // Testing
        "vitest.explorer",
        "ms-playwright.playwright"
      ],
      "settings": {
        // ESLint: fix all problems on save (Prettier formats on save, see base image)
        "eslint.enable": true,
        "eslint.codeActionsOnSave.mode": "all",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },

        // Disable extension recommendations
        "extensions.ignoreRecommendations": true,

        // Hide configuration folders from students
        "files.exclude": {
          "**/.devcontainer": true
        },

        // Live Preview: open in the external browser, serve the build output
        "livePreview.openPreviewTarget": "External Browser",
        "livePreview.serverRoot": "dist",

        // GitHub Issues and Pull Requests
        "githubPullRequests.remotes": ["origin"],
        "githubIssues.issueCompletionFormatScm": "${issueTitle} Fixes ${issueNumberLabel}",
        "githubIssues.issueBranchTitle": "${user}/issue${issueNumber}-${sanitizedLowercaseIssueTitle}",
        "githubIssues.workingBaseBranch": "defaultBranch",
        "githubPullRequests.createDefaultBaseBranch": "createdFromBranch",
        "githubPullRequests.createOnPublishBranch": "always"
      }
    }
  }
}
